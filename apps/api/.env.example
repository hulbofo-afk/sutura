NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sutura:sutura@localhost:55432/sutura
JWT_SECRET=change-this-before-production
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL used by the API for local upload PUT/download links.
API_PUBLIC_URL=http://localhost:4000
STORAGE_DRIVER=local
LOCAL_UPLOAD_SECRET=change-me
PRISMA_POOL_MIN=1
PRISMA_POOL_MAX=10
PRISMA_CONNECTION_TIMEOUT_MS=5000
PRISMA_STATEMENT_TIMEOUT_MS=15000
IMOLE_API_KEY=
IMOLE_BASE_URL=https://api.imole.app/v1
IMOLE_MODEL=gpt-5.6-luna

# --- Cloudflare R2 (required only when STORAGE_DRIVER=r2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=suturamode-media
# R2_PUBLIC_BASE_URL=https://media.suturamode.com

# --- SMTP (password reset emails) ---
# If SMTP_HOST is not set, password reset emails are logged to stdout (dev).
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@suturamode.com
# SMTP_PASS=secret
# SMTP_FROM=no-reply@suturamode.com
# SMTP_FROM_NAME=Sutura

# Production must configure SMTP_HOST; development logs links when omitted.


# --- OpenAPI / Docs ---
ENABLE_SWAGGER=true
